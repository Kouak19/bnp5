import React from 'react';
import { useBank } from '../context/BankContext';

const RIBView = () => {
  const { user, rib, showToast } = useBank();

  const copyToClipboard = (text, label) => {
    navigator.clipboard.writeText(text)
      .then(() => {
        alert(`${label} copié dans le presse-papiers !`);
        showToast(`${label} copié`, "success");
      })
      .catch(err => {
        console.error('Erreur lors de la copie: ', err);
      });
  };

  return (
    <div style={{ margin: '0 auto', maxWidth: '1200px' }}>
      <div className="welcome">
        <h4>Relevé d'identité bancaire</h4>
      </div>

      {/* RIB National */}
      <div className="container">
        <div className="rib_title">
          <div className="bank-logo">
            <svg viewBox="0 0 160 40" style={{ height: '35px', width: 'auto' }}>
              <path d="M10,12 C30,5 55,5 75,14 C95,23 110,20 120,12" fill="none" stroke="white" strokeWidth="4" strokeLinecap="round" />
              <text x="70" y="32" fill="white" fontSize="14" fontWeight="800" fontFamily="'Segoe UI', sans-serif" letterSpacing="1px">BNP PARIBAS</text>
            </svg>
          </div>
          <div className="secured-badge" style={{
            display: 'inline-flex',
            alignItems: 'center',
            backgroundColor: 'rgba(255, 255, 255, 0.2)',
            padding: '5px 10px',
            borderRadius: '20px',
            fontSize: '0.8rem',
            fontWeight: '600'
          }}>
            <i className="fas fa-shield-alt" style={{ marginRight: '5px' }}></i> SÉCURISÉ
          </div>
        </div>
        
        <div className="rib_content">
          <div className="rib_part animate-reveal">
            <p className="rib_label"><i className="fas fa-user"></i> Nom du Titulaire</p>
            <p className="rib_value">{user.name || 'Georgina Ruaux'}</p>
          </div>
          
          <div className="rib_part animate-reveal">
            <p className="rib_label"><i className="fas fa-university"></i> Domiciliation</p>
            <p className="rib_value">{rib.bankName || 'BNP PARIBAS'}</p>
          </div>
          
          <div className="rib_part animate-reveal">
            <p className="rib_label"><i className="fas fa-building"></i> Code Banque</p>
            <p className="rib_value">{rib.bankCode || '30004'}</p>
          </div>
          
          <div className="rib_part animate-reveal">
            <p className="rib_label"><i className="fas fa-landmark"></i> Code Agence</p>
            <p className="rib_value">{rib.branchCode || '00819'}</p>
          </div>
          
          <div className="rib_part animate-reveal">
            <p className="rib_label"><i className="fas fa-list-ol"></i> Numéro de Compte</p>
            <div className="tooltip" style={{ display: 'inline-block', position: 'relative' }}>
              <p className="rib_value">
                {rib.accountNumber || '54350123000'}
                <button className="copy-btn" onClick={() => copyToClipboard(rib.accountNumber || '54350123000', "Numéro de compte")}>
                  <i className="far fa-copy"></i>
                </button>
              </p>
            </div>
          </div>
          
          <div className="rib_part animate-reveal">
            <p className="rib_label"><i className="fas fa-key"></i> Clé RIB</p>
            <p className="rib_value">{rib.key || '61'}</p>
          </div>
        </div>
      </div>
      
      {/* RIB International */}
      <div className="container">
        <div className="rib_title">
          <div className="bank-logo">
            <svg viewBox="0 0 160 40" style={{ height: '35px', width: 'auto' }}>
              <path d="M10,12 C30,5 55,5 75,14 C95,23 110,20 120,12" fill="none" stroke="white" strokeWidth="4" strokeLinecap="round" />
              <text x="70" y="32" fill="white" fontSize="14" fontWeight="800" fontFamily="'Segoe UI', sans-serif" letterSpacing="1px">BNP PARIBAS</text>
            </svg>
          </div>
          <span>FR</span>
        </div>
        
        <div className="rib_content">
          <div className="rib_part animate-reveal iban-section">
            <p className="rib_label"><i className="fas fa-globe-europe"></i> IBAN</p>
            <div className="tooltip" style={{ display: 'inline-block', position: 'relative' }}>
              <p className="rib_value">
                {rib.iban || 'FR76 3000 4008 1954 3501 2300 061'}
                <button className="copy-btn" onClick={() => copyToClipboard(rib.iban || 'FR76 3000 4008 1954 3501 2300 061', "IBAN")}>
                  <i className="far fa-copy"></i>
                </button>
              </p>
            </div>
          </div>
          
          <div className="rib_part animate-reveal">
            <p className="rib_label"><i className="fas fa-code-branch"></i> Code SWIFT (BIC)</p>
            <div className="tooltip" style={{ display: 'inline-block', position: 'relative' }}>
              <p className="rib_value">
                {rib.swift || 'BNPAFRPPXXX'}
                <button className="copy-btn" onClick={() => copyToClipboard(rib.swift || 'BNPAFRPPXXX', "SWIFT/BIC")}>
                  <i className="far fa-copy"></i>
                </button>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default RIBView;
