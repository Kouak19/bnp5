import React, { useEffect, useRef } from 'react';
import { useBank } from '../context/BankContext';

const Dashboard = () => {
  const { user, accounts, transactions, globalBalance, setCurrentView } = useBank();
  
  // Format currencies beautifully in French locale
  const formatCurrency = (val) => {
    return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(val);
  };

  const recentTransactions = transactions.slice(0, 5); // Take 5 recent

  return (
    <>
      <div className="profile-card">
        <div className="profile-header">
          <div className="profile-info">
            <h2>{user.name || 'Sandra Klopp'}</h2>
            <div className="location">
              <i className="fas fa-map-marker-alt"></i>
              <span>France</span>
            </div>
            <p style={{ color: 'var(--text-secondary)', marginBottom: '0.5rem' }}>
              Gestionnaire: <span style={{ color: 'var(--accent-color)' }}>Arnaud Leroy</span>
            </p>
            <p style={{ color: 'var(--text-secondary)' }} id="lastConnection">
              Dernière connexion: <span>{user.lastConnection || new Date().toLocaleString('fr-FR')}</span>
            </p>
          </div>
          <div className="balance-info">
            <div className="account-status">
              <span className="status-dot"></span>
              Actif
            </div>
            <div className="balance-amount">{formatCurrency(globalBalance)}</div>
            <div className="balance-label">Solde disponible</div>
          </div>
        </div>
      </div>

      {/* Quick Actions */}
      <div className="quick-actions">
        <div className="action-card" onClick={() => setCurrentView('virement')}>
          <i className="fas fa-paper-plane"></i>
          <div>Virement rapide</div>
        </div>
        <div className="action-card" onClick={() => setCurrentView('rib')}>
          <i className="fas fa-qrcode"></i>
          <div>Payer par QR</div>
        </div>
        <div className="action-card" onClick={() => setCurrentView('virement')}>
          <i className="fas fa-clock"></i>
          <div>Virement programmé</div>
        </div>
        <div className="action-card" onClick={() => setCurrentView('cartes')}>
          <i className="fas fa-money-check"></i>
          <div>Chéquiers / Cartes</div>
        </div>
      </div>

      <h2 className="section-title">
        Vos comptes
        <a href="#" className="view-all" onClick={(e) => { e.preventDefault(); setCurrentView('dashboard'); }}>Voir tout <i className="fas fa-chevron-right"></i></a>
      </h2>

      <div className="accounts-grid">
        {accounts.map((acc, index) => (
          <div className="account-card" key={acc.id || index}>
            <div className="account-header">
              <div>
                <div className="account-type">{acc.type}</div>
                <div className="account-number">{acc.number}</div>
              </div>
              <div className="account-icon">
                <i className={`fas ${acc.icon === 'wallet' ? 'fa-wallet' : 'fa-piggy-bank'}`}></i>
              </div>
            </div>
            <div className="account-balance">{formatCurrency(acc.balance)}</div>
          </div>
        ))}
      </div>

      <h2 className="section-title">Dernières opérations</h2>
      <div className="transactions">
        <div className="transaction-header">
          <h3>Transactions récentes</h3>
          <a href="#" className="view-all" onClick={(e) => { e.preventDefault(); setCurrentView('historique'); }}>Voir l'historique</a>
        </div>
        <div className="transaction-list">
          {recentTransactions.map((tx, index) => {
            const isNegative = tx.amount < 0;
            return (
              <div className="transaction-item" key={tx.id || index}>
                <div className="transaction-info">
                  <div className="transaction-icon">
                    <i className="fas fa-exchange-alt"></i>
                  </div>
                  <div className="transaction-details">
                    <div className="transaction-title">{tx.type}</div>
                    <div className="transaction-date">{tx.date}</div>
                    <div className="transaction-reference" style={{ fontSize: '0.8rem', color: 'var(--text-secondary)' }}>{tx.reference}</div>
                  </div>
                </div>
                <div className={`transaction-amount ${isNegative ? 'amount-negative' : 'amount-positive'}`}>
                  {isNegative ? '-' : '+'} {formatCurrency(Math.abs(tx.amount))}
                </div>
              </div>
            );
          })}
          {recentTransactions.length === 0 && (
            <div style={{ padding: '1rem 1.5rem', textAlign: 'center', color: 'var(--text-secondary)' }}>
              Aucune opération récente
            </div>
          )}
        </div>
      </div>
    </>
  );
};

export default Dashboard;
