import React, { useState } from 'react';
import { useBank } from '../context/BankContext';

const Cards = () => {
  const { card, toggleCardBlock, toggleForeignPayments, updateCardLimit, transactions } = useBank();
  const [isBlocked, setIsBlocked] = useState(card.isBlocked || false);
  const [foreignPayments, setForeignPayments] = useState(card.foreignPayments || false);

  const formatCurrency = (val) => {
    return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(val);
  };

  // Card transactions filter
  const cardTransactions = transactions.filter(t => t.amount < 0 && t.type.toLowerCase().includes('carte') || t.type.toLowerCase().includes('carrefour') || t.type.toLowerCase().includes('station') || t.type.toLowerCase().includes('restaurant') || t.type.toLowerCase().includes('bistrot'));

  const handleBlockToggle = (e) => {
    e.preventDefault();
    const nextState = !isBlocked;
    setIsBlocked(nextState);
    toggleCardBlock();
    alert(nextState ? "Votre carte a été bloquée temporairement." : "Votre carte a été débloquée.");
  };

  const handleForeignToggle = (e) => {
    e.preventDefault();
    const nextState = !foreignPayments;
    setForeignPayments(nextState);
    toggleForeignPayments();
    alert(nextState ? "Paiements à l'étranger activés." : "Paiements à l'étranger désactivés.");
  };

  const handleLimitChange = (e) => {
    e.preventDefault();
    const currentLimit = card.limit || 2500;
    const newLimit = currentLimit === 2500 ? 5000 : 2500;
    updateCardLimit(newLimit);
    alert(`Nouveau plafond de paiement défini : ${formatCurrency(newLimit)}`);
  };

  return (
    <div className="container" style={{ margin: '0 auto', maxWidth: '1200px' }}>
      <div className="card-wrapper">
        <div className="credit-card" style={{
          position: 'relative',
          opacity: isBlocked ? 0.7 : 1,
          transition: 'opacity 0.3s'
        }}>
          <div className="card-chip"></div>
          <div className="card-number">
            {isBlocked ? "**** **** **** ****" : (card.number || "**** **** **** 2284")}
          </div>
          <div className="card-info">
            <div className="card-holder">
              <div className="card-label">Titulaire</div>
              <div>{card.holder || 'Georgina Ruaux'}</div>
            </div>
            <div className="card-expires">
              <div className="card-label">Expire</div>
              <div>{card.expiry || '12/27'}</div>
            </div>
          </div>
          {isBlocked && (
            <div style={{
              position: 'absolute',
              top: '50%',
              left: '50%',
              transform: 'translate(-50%, -50%)',
              background: 'rgba(231, 76, 60, 0.9)',
              padding: '0.5rem 1rem',
              borderRadius: '0.25rem',
              color: 'white',
              fontWeight: 'bold',
              fontSize: '0.8rem',
              letterSpacing: '2px'
            }}>CARTE BLOQUÉE</div>
          )}
        </div>
      </div>

      <div className="card-actions">
        <div className="action-grid">
          <a href="#" className="action-button" onClick={handleBlockToggle}>
            <i className={`fas ${isBlocked ? 'fa-unlock' : 'fa-lock'}`}></i>
            <span>{isBlocked ? 'Débloquer' : 'Bloquer'}</span>
          </a>
          <a href="#" className="action-button" onClick={handleLimitChange}>
            <i className="fas fa-sliders-h"></i>
            <span>Plafonds ({formatCurrency(card.limit || 2500)})</span>
          </a>
          <a href="#" className="action-button" onClick={handleForeignToggle}>
            <i className="fas fa-globe"></i>
            <span>Étranger ({foreignPayments ? 'Actif' : 'Inactif'})</span>
          </a>
          <a href="#" className="action-button" onClick={(e) => { e.preventDefault(); alert("Code PIN envoyé par SMS."); }}>
            <i className="fas fa-key"></i>
            <span>Code PIN</span>
          </a>
        </div>
      </div>

      <div className="transactions">
        <div className="transaction-header">
          <h3>Dernières transactions</h3>
          <a href="#" style={{ color: 'var(--accent-color)', textDecoration: 'none' }}>Voir tout</a>
        </div>
        <div className="transaction-list">
          {cardTransactions.map((tx, idx) => (
            <div className="transaction-item" key={tx.id || idx}>
              <div className="transaction-info">
                <div className="transaction-icon">
                  <i className={`fas ${tx.type.toLowerCase().includes('essence') || tx.type.toLowerCase().includes('total') ? 'fa-gas-pump' : tx.type.toLowerCase().includes('resto') || tx.type.toLowerCase().includes('bistrot') ? 'fa-utensils' : 'fa-shopping-cart'}`}></i>
                </div>
                <div className="transaction-details">
                  <h4>{tx.type}</h4>
                  <p>{tx.date}</p>
                </div>
              </div>
              <div className="amount negative">-{formatCurrency(Math.abs(tx.amount))}</div>
            </div>
          ))}
          {cardTransactions.length === 0 && (
            <>
              <div className="transaction-item">
                <div className="transaction-info">
                  <div className="transaction-icon">
                    <i className="fas fa-shopping-cart"></i>
                  </div>
                  <div className="transaction-details">
                    <h4>Carrefour Market</h4>
                    <p>10 Sept 2020 - 15:30</p>
                  </div>
                </div>
                <div className="amount negative">-85,42 €</div>
              </div>
              <div className="transaction-item">
                <div className="transaction-info">
                  <div className="transaction-icon">
                    <i className="fas fa-gas-pump"></i>
                  </div>
                  <div className="transaction-details">
                    <h4>Station Total</h4>
                    <p>03 Sept. 2020 - 10:15</p>
                  </div>
                </div>
                <div className="amount negative">-65,00 €</div>
              </div>
              <div className="transaction-item">
                <div className="transaction-info">
                  <div className="transaction-icon">
                    <i className="fas fa-utensils"></i>
                  </div>
                  <div className="transaction-details">
                    <h4>Restaurant Le Bistrot</h4>
                    <p>02 Sept 2020 - 20:45</p>
                  </div>
                </div>
                <div className="amount negative">-42,50 €</div>
              </div>
            </>
          )}
        </div>
      </div>
    </div>
  );
};

export default Cards;
